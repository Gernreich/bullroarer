# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The 3D viewer is built from the cut files by viewer.rs (Rust; repro-svg
# builds it), which reads them with lasermade-tools' turn3d module, so it
# expects that checkout beside this one.

# --- the cut files: no command in this repository redraws them. They are
# the source the previews and the viewer are built from. ---
BullroarerConcaveTapered.svg :: !
BullroarerConvexNarrowTapered.svg :: !
BullroarerConvexTapered.svg :: !
BullroarerRectangular.svg :: !
BullroarerSawtooth.svg :: !

# --- the previews: display renderings of the cut files ---
previews/BullroarerConcaveTapered.svg :: ../lasermade-tools/target/release/make-preview BullroarerConcaveTapered.svg $OUT
previews/BullroarerConvexNarrowTapered.svg :: ../lasermade-tools/target/release/make-preview BullroarerConvexNarrowTapered.svg $OUT
previews/BullroarerConvexTapered.svg :: ../lasermade-tools/target/release/make-preview BullroarerConvexTapered.svg $OUT
previews/BullroarerRectangular.svg :: ../lasermade-tools/target/release/make-preview BullroarerRectangular.svg $OUT
previews/BullroarerSawtooth.svg :: ../lasermade-tools/target/release/make-preview BullroarerSawtooth.svg $OUT

# --- the pages ---
index.html :: ../lasermade-tools/target/release/md2html index.md $OUT
bullroarer-3d.html :: target/release/viewer --out=$OUT
