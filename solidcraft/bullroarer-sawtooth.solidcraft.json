{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"the ply: one lamination"}},
{"command":"parameters.add","params":{"name":"laminations","expression":"1","unit":"","comment":"blades glued face to face: the design's thickness is laminations × ply"}},
{"command":"parameters.add","params":{"name":"length","expression":"169.2231 mm","comment":"the blade, end to end"}},
{"command":"parameters.add","params":{"name":"teeth","expression":"30","unit":"","comment":"teeth down each edge"}},
{"command":"parameters.add","params":{"name":"core","expression":"34.4578 mm","comment":"the blade between the teeth's roots"}},
{"command":"parameters.add","params":{"name":"depth","expression":"16.5922 mm","comment":"a tooth, root to tip"}},
{"command":"parameters.add","params":{"name":"lean","expression":"0.4485","unit":"","comment":"a tooth's tip along its pitch, from the end it starts at"}},
{"command":"parameters.add","params":{"name":"hole_d","expression":"7 mm","comment":"the cord hole"}},
{"command":"parameters.add","params":{"name":"hole_inset","expression":"8.7918 mm","comment":"the cord hole's centre from the near end"}},
{"command":"parameters.add","params":{"name":"thick","expression":"laminations*ply","comment":"read only: the blade's thickness"}},
{"command":"sketch.create","params":{"plane":"XY","name":"bullroarer sawtooth sketch"}},
{"command":"sketch.rectangle.two_point","params":{"p0":["0 mm","-core/2"],"p1":["length","core/2"]}},
{"command":"sketch.finish","params":{}},
{"command":"solid.extrude","params":{"sketch":"bullroarer sawtooth sketch","distance":"thick","operation":"new","name":"bullroarer sawtooth","body_name":"bullroarer sawtooth"}},
{"command":"sketch.create","params":{"plane":"XY","name":"bullroarer sawtooth tooth 1 sketch"}},
{"command":"sketch.line","params":{"points":[["0 mm","core/2"],["lean*length/teeth","core/2 + depth"],["length/teeth","core/2"]],"closed":true}},
{"command":"sketch.finish","params":{}},
{"command":"solid.extrude","params":{"sketch":"bullroarer sawtooth tooth 1 sketch","distance":"thick","operation":"join","targets":["bullroarer sawtooth"],"name":"bullroarer sawtooth tooth 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["bullroarer sawtooth tooth 1"],"dir1":[1,0,0],"count1":"teeth","spacing1":"length/teeth","name":"bullroarer sawtooth tooth 1 pattern"}},
{"command":"sketch.create","params":{"plane":"XY","name":"bullroarer sawtooth tooth 2 sketch"}},
{"command":"sketch.line","params":{"points":[["0 mm","-core/2"],["(1 - lean)*length/teeth","-core/2 - depth"],["length/teeth","-core/2"]],"closed":true}},
{"command":"sketch.finish","params":{}},
{"command":"solid.extrude","params":{"sketch":"bullroarer sawtooth tooth 2 sketch","distance":"thick","operation":"join","targets":["bullroarer sawtooth"],"name":"bullroarer sawtooth tooth 2"}},
{"command":"solid.pattern.rectangular","params":{"features":["bullroarer sawtooth tooth 2"],"dir1":[1,0,0],"count1":"teeth","spacing1":"length/teeth","name":"bullroarer sawtooth tooth 2 pattern"}},
{"command":"solid.cylinder","params":{"base":["length - hole_inset","0 mm","-1 mm"],"diameter":"hole_d","height":"thick + 2 mm","operation":"cut","targets":["bullroarer sawtooth"],"name":"bullroarer sawtooth cord hole"}},
{"command":"inspect.measure","params":{}}
]}
